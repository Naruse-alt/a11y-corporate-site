---
// サイトフッター。連絡先やコピーライトに加え、フッターナビを配置。
// フッターは footerNavItems（主要＋二次）を参照し、
// ヘッダーに載せないページ（FAQ 等）も含めて到達性を担保する
// (3.2.3 一貫したナビゲーション AA)。
import { footerNavItems } from '../data/nav';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <div class="site-footer__about">
      <p class="site-footer__brand">Inclusive Works</p>
      <p class="site-footer__note">
        Web アクセシビリティ対応を強みとする架空企業のポートフォリオです。
        WCAG 2.2 レベル AA の達成を目標とします。
      </p>
    </div>

    <nav class="site-footer__nav" aria-label="フッターナビゲーション">
      <ul>
        {
          footerNavItems.map((item) => (
            <li>
              <a class="link-quiet" href={item.href}>{item.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>

  <div class="container site-footer__bar">
    <p class="site-footer__copy">&copy; {year} Inclusive Works</p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--space-20);
    border-top: 1px solid var(--color-border-subtle);
    background-color: var(--color-surface);
    padding-block: var(--space-12) var(--space-6);
  }

  .site-footer__inner {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-8) var(--space-12);
    justify-content: space-between;
  }

  .site-footer__about {
    flex: 1 1 20rem;
  }

  .site-footer__brand {
    margin: 0 0 var(--space-2);
    font-size: var(--text-lg);
    font-weight: 700;
    color: var(--color-text);
  }

  .site-footer__note {
    margin: 0;
    color: var(--color-text-muted);
  }

  .site-footer__nav ul {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* 下線の有無は global.css の .link-quiet に委ねる */
  .site-footer__nav a {
    display: inline-flex;
    align-items: center;
    min-height: var(--target-min);
    color: var(--color-link);
  }

  .site-footer__bar {
    margin-top: var(--space-8);
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border-subtle);
  }

  .site-footer__copy {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }
</style>

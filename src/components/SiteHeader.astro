---
// サイトヘッダー。
// ナビゲーションは <nav> で表現し、現在地は aria-current="page" で示す。
// 同種ランドマークが複数になる場合に備え aria-label で区別する。
const { path = '/' } = Astro.props as { path?: string };

const links = [
  { href: '/', label: 'ホーム' },
  { href: '/accessibility/', label: 'アクセシビリティ方針' },
];

const isCurrent = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);
---

<header class="site-header">
  <div class="container site-header__inner">
    <a class="site-header__brand" href="/">Inclusive&nbsp;Works</a>

    <nav aria-label="サイト内メインナビゲーション">
      <ul class="site-nav">
        {
          links.map((link) => (
            <li>
              <a
                href={link.href}
                aria-current={isCurrent(link.href) ? 'page' : undefined}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    {/* テーマ切替はJSによる進歩的強化。JS無効時はOS設定に従い、死んだUIを残さない。 */}
    <div id="theme-toggle-slot"></div>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 2px solid var(--color-border);
    background-color: var(--color-surface);
  }

  .site-header__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4);
    padding-block: var(--space-3);
  }

  .site-header__brand {
    font-weight: 700;
    font-size: 1.25rem;
    color: var(--color-text);
    text-decoration: none;
  }

  .site-header__brand:hover {
    text-decoration: underline;
  }

  nav {
    margin-inline-start: auto;
  }

  .site-nav {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-nav a {
    display: inline-flex;
    align-items: center;
    min-height: var(--target-min);
    padding-inline: var(--space-3);
    color: var(--color-link);
    text-decoration: none;
  }

  .site-nav a:hover {
    text-decoration: underline;
  }

  /* 現在地は色だけでなく下線でも示す (1.4.1 A) */
  .site-nav a[aria-current='page'] {
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 0.3em;
    text-decoration-thickness: 2px;
  }
</style>

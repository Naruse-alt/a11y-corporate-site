---
import '../styles/global.css';
import SkipLink from '../components/SkipLink.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
const path = Astro.url.pathname;
const fullTitle = `${title} | Inclusive Works`;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    {description && <meta name="description" content={description} />}

    {/*
      ちらつき防止: 描画前に保存済みテーマを適用する。
      localStorage に値が無ければ何もせず OS 設定 (@media) に委ねる。
    */}
    <script is:inline>
      (() => {
        try {
          const saved = localStorage.getItem('theme');
          if (saved === 'light' || saved === 'dark') {
            document.documentElement.setAttribute('data-theme', saved);
          }
        } catch (_) {
          /* localStorage 不可の環境では OS 設定に委ねる */
        }
      })();
    </script>
  </head>
  <body>
    <SkipLink />
    <SiteHeader path={path} />

    <main id="main" class="container main-content">
      <slot />
    </main>

    <SiteFooter />

    {/*
      テーマ切替の進歩的強化。
      ネイティブ <button> をJSで生成して挿入する。
      ラベルのテキスト自体が操作内容を伝えるため、追加の ARIA は付けない。
    */}
    <script is:inline>
      (() => {
        const slot = document.getElementById('theme-toggle-slot');
        if (!slot) return;

        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)');
        const effective = () => {
          const attr = document.documentElement.getAttribute('data-theme');
          if (attr === 'light' || attr === 'dark') return attr;
          return prefersDark.matches ? 'dark' : 'light';
        };

        const button = document.createElement('button');
        button.type = 'button';
        button.className = 'button button--ghost theme-toggle';

        const render = () => {
          const isDark = effective() === 'dark';
          button.textContent = isDark ? 'ライトモードにする' : 'ダークモードにする';
        };

        button.addEventListener('click', () => {
          const next = effective() === 'dark' ? 'light' : 'dark';
          document.documentElement.setAttribute('data-theme', next);
          try {
            localStorage.setItem('theme', next);
          } catch (_) {
            /* 保存できなくても表示切替は機能する */
          }
          render();
        });

        // OS 設定が変わったら(手動選択が無い場合の)ラベルを追従
        prefersDark.addEventListener('change', render);

        render();
        slot.appendChild(button);
      })();
    </script>

    <style>
      .main-content {
        padding-block: var(--space-8);
      }

      .theme-toggle {
        padding-block: var(--space-2);
        padding-inline: var(--space-4);
        font-weight: 600;
      }
    </style>
  </body>
</html>

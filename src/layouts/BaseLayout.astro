---
// サブセット別 CSS は無いため、全部入りの wght 軸（font-weight: 100 900）を読み込む。
import '@fontsource-variable/noto-sans-jp/wght.css';
import '../styles/global.css';
import SkipLink from '../components/SkipLink.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Breadcrumb from '../components/Breadcrumb.astro';

interface Props {
  title: string;
  description?: string;
  /** サイト相対パス。省略時は既定の OG 画像 */
  ogImage?: string;
}

interface Crumb {
  href?: string;
  label: string;
}

const { title, description, ogImage = '/images/og-image.jpg' } = Astro.props;
const path = Astro.url.pathname;
const fullTitle = `${title} | Inclusive Works`;

// トップページ以外はパンくずを表示する。
// 現在地ラベルはページの title をそのまま使うため、ページ側の追記は不要。
const breadcrumbs: Crumb[] | null =
  path === '/' ? null : [{ href: '/', label: 'ホーム' }, { label: title }];

// site は astro.config の絶対 URL。canonical / og:image に使う。
const site = Astro.site ?? new URL('https://a11y-corporate-site.naruse-works.workers.dev');
const canonicalUrl = new URL(path, site).href;
const ogImageUrl = new URL(ogImage, site).href;
const ogImageAlt =
  '車いすの人や白杖を持つ人など4人がノートPCを囲む手描きイラストと、Inclusive Works のロゴ';
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonicalUrl} />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    {/* ブラウザ UI の色。値はパレット A の --color-bg（ライト／ダーク）に合わせる */}
    <meta name="theme-color" content="#fbf9f4" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#131819" media="(prefers-color-scheme: dark)" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Inclusive Works" />
    <meta property="og:title" content={fullTitle} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:locale" content="ja_JP" />
    <meta name="twitter:card" content="summary_large_image" />

    {/*
      ちらつき防止: 描画前に保存済みテーマを適用する。
      localStorage に値が無ければ何もせず OS 設定 (@media) に委ねる。
    */}
    <script is:inline>
      (() => {
        try {
          const saved = localStorage.getItem('theme');
          if (saved === 'light' || saved === 'dark') {
            document.documentElement.setAttribute('data-theme', saved);
          }
        } catch (_) {
          /* localStorage 不可の環境では OS 設定に委ねる */
        }
      })();
    </script>
  </head>
  <body>
    <SkipLink />
    <SiteHeader path={path} />

    {/*
      スキップリンク先。href="#main" のページ内移動でフォーカスを受け取るには
      フォーカス可能である必要がある（tabindex="-1"。正の値は使わない）。
      2.4.1 ブロックスキップ A / 2.4.3 フォーカス順序 A
    */}
    <main id="main" class="container main-content" tabindex="-1">
      {breadcrumbs && <Breadcrumb items={breadcrumbs} />}
      <slot />
    </main>

    <SiteFooter />

    {/*
      テーマ切替の進歩的強化。
      ネイティブ <button> をJSで生成して挿入する。
      アイコンのみのため、名前は aria-label で担保する（可視テキストが無い
      ネイティブ button は名前を持てないため、例外的に ARIA を付与する）。
      アイコンは「切り替えた先のモード」を表す慣習に従う（月=ダーク / 太陽=ライト）。
    */}
    <script is:inline>
      (() => {
        const slot = document.getElementById('theme-toggle-slot');
        if (!slot) return;

        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)');
        const effective = () => {
          const attr = document.documentElement.getAttribute('data-theme');
          if (attr === 'light' || attr === 'dark') return attr;
          return prefersDark.matches ? 'dark' : 'light';
        };

        const ICON_MOON =
          '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>';
        const ICON_SUN =
          '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>';

        const button = document.createElement('button');
        button.type = 'button';
        button.className = 'theme-toggle';

        const render = () => {
          const isDark = effective() === 'dark';
          const label = isDark ? 'ライトモードに切り替える' : 'ダークモードに切り替える';
          button.setAttribute('aria-label', label);
          button.setAttribute('title', label);
          button.innerHTML = isDark ? ICON_SUN : ICON_MOON;
        };

        button.addEventListener('click', () => {
          const next = effective() === 'dark' ? 'light' : 'dark';
          document.documentElement.setAttribute('data-theme', next);
          try {
            localStorage.setItem('theme', next);
          } catch (_) {
            /* 保存できなくても表示切替は機能する */
          }
          render();
        });

        // OS 設定が変わったら(手動選択が無い場合の)アイコン/ラベルを追従
        prefersDark.addEventListener('change', render);

        render();
        slot.appendChild(button);
      })();
    </script>

    <style>
      .main-content {
        padding-block: var(--space-8);
      }
    </style>
  </body>
</html>

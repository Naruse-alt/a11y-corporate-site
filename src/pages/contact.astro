---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/form/ContactForm.astro';
import AnnotationCue from '../components/AnnotationCue.astro';

/*
 * お問い合わせページ（送信なしデモ）。
 * 見せ場はフォームのラベル関連付け・必須の明示・エラー特定／修正提案・成功通知。
 */
---

<BaseLayout
  title="お問い合わせ"
  description="Inclusive Works へのお問い合わせ（デモ）。送信は行わず、入力検証と成功メッセージの振る舞いを確認できます。"
>
  <article class="contact-page">
    <header class="contact-page__intro">
      <p class="eyebrow">Contact</p>
      <h1>お問い合わせ</h1>
      <p class="lead">
        サービスやアクセシビリティ方針についてのご質問を想定したデモフォームです。
        検証エラーと成功時の通知を確認できます。
      </p>
      <p class="contact-page__note">
        Inclusive Works は架空の会社です。このフォームから実際に送信・連絡することはできません。
      </p>
    </header>

    <ContactForm />

    <AnnotationCue topicId="contact" />
  </article>
</BaseLayout>

<style>
  .contact-page {
    max-width: var(--measure);
  }

  .contact-page__intro {
    margin-block-end: var(--space-8);
  }

  .contact-page__intro h1 {
    font-size: var(--text-3xl);
  }

  .contact-page__note {
    margin-block-start: var(--space-4);
    color: var(--color-text-muted);
  }
</style>

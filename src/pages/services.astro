---
import BaseLayout from '../layouts/BaseLayout.astro';
import { services } from '../data/services';

/*
 * サービス詳細ページ。
 *
 * インタラクションはページ内リンク（ネイティブ <a href="#...">）のみ。
 * 独自タブ UI やアコーディオンは使わない——長文の説明は見出しで構造化し、
 * 最初からすべて読めるようにする（JS 不要 / 1.3.1 / 2.4.1）。
 */
---

<BaseLayout
  title="サービス"
  description="Inclusive Works の提供サービス。アクセシビリティ診断、設計・実装支援、運用・教育の内容と成果物を紹介します。"
>
  <article class="services-page">
    <header class="services-page__intro">
      <p class="eyebrow">Services</p>
      <h1>提供サービス</h1>
      <p class="lead">
        診断から設計・実装、運用・教育まで。Web アクセシビリティ対応を、
        ネイティブ HTML を優先する方針で一貫して支援します。
      </p>
    </header>

    {/*
      ページ内目次。同種の nav と区別するため aria-label を付与。
      スキップしやすくするため、長い本文の前に配置する (2.4.1)。
    */}
    <nav class="services-toc" aria-label="サービス一覧">
      <h2 class="services-toc__heading">目次</h2>
      <ol>
        {
          services.map((service) => (
            <li>
              <a href={`#${service.id}`}>{service.title}</a>
            </li>
          ))
        }
      </ol>
    </nav>

    {
      services.map((service) => (
        <section class="service-block section" id={service.id} aria-labelledby={`${service.id}-heading`}>
          <h2 id={`${service.id}-heading`}>{service.title}</h2>
          <p class="lead">{service.lead}</p>

          <h3>主な内容</h3>
          <ul>
            {service.points.map((point) => (
              <li>{point}</li>
            ))}
          </ul>

          <h3>成果物の例</h3>
          <ul>
            {service.deliverables.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </section>
      ))
    }

    <section class="section services-page__closing" aria-labelledby="services-next-heading">
      <h2 id="services-next-heading">方針とよくある質問</h2>
      <p>
        準拠基準や試験の考え方は
        <a href="/accessibility/">アクセシビリティ方針</a>
        にまとめています。具体的な疑問は
        <a href="/faq/">よくある質問</a>
        も参照してください。
      </p>
      <p class="services-page__cta">
        <a class="button" href="/accessibility/">アクセシビリティ方針を読む</a>
        <a class="button button--ghost" href="/faq/">よくある質問を見る</a>
      </p>
    </section>
  </article>
</BaseLayout>

<style>
  .services-page {
    max-width: var(--measure);
  }

  .services-page__intro h1 {
    font-size: var(--text-3xl);
  }

  .services-toc {
    margin-block: var(--space-8);
    padding: var(--space-4) var(--space-6);
    background-color: var(--color-surface-2);
    border-radius: var(--radius);
    border-inline-start: 4px solid var(--color-primary);
  }

  .services-toc__heading {
    margin: 0 0 var(--space-3);
    font-size: var(--text-sm);
    letter-spacing: 0.06em;
  }

  .services-toc ol {
    margin: 0;
    padding-inline-start: 1.25em;
  }

  .services-toc li + li {
    margin-block-start: var(--space-2);
  }

  .service-block h2 {
    /* sticky header 分の余白。固定高さのボックスではない */
    scroll-margin-top: 5rem;
  }

  .service-block ul {
    padding-inline-start: 1.25em;
  }

  .service-block li + li {
    margin-block-start: var(--space-2);
  }

  .services-page__cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-block-start: var(--space-6);
    max-width: none;
  }

  @media (forced-colors: active) {
    .services-toc {
      border: 1px solid CanvasText;
      border-inline-start-width: 4px;
    }
  }
</style>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import AnnotationCue from '../components/AnnotationCue.astro';
import { services } from '../data/services';
---

<BaseLayout
  title="ホーム"
  description="Web アクセシビリティ対応を強みとする架空企業 Inclusive Works のコーポレートサイト。WCAG 2.2 レベル AA の達成を目標とします。"
>
  <section class="hero" aria-labelledby="hero-heading">
    {/* 装飾。情報を持たないため aria-hidden。 */}
    <span class="hero__decoration" aria-hidden="true"></span>

    <div class="hero__grid">
      <div class="hero__body">
        <p class="eyebrow">Web アクセシビリティ</p>
        <h1 id="hero-heading">誰も取り残さない Web を、標準の力で。</h1>
        <p class="lead">
          Inclusive Works は Web アクセシビリティ対応を強みとする制作会社です。
          WCAG 2.2 レベル AA の達成を目標とし、試験結果を公開します。
        </p>
        <p class="hero__actions">
          <a class="button" href="/accessibility/">アクセシビリティ方針を読む</a>
          <a class="button button--ghost" href="/services/">提供サービスを見る</a>
        </p>
      </div>

      {/*
        右カラムのイラスト。雰囲気を伝える補助なので、短い代替テキストに留める。
        ページの主張は見出し・リードが担う（1.1.1）。
      */}
      <div class="hero__visual">
        <picture>
          <source
            type="image/webp"
            srcset="/images/hero-inclusive-web.webp"
          />
          <img
            class="hero__image"
            src="/images/hero-inclusive-web.png"
            width="1200"
            height="800"
            alt="多様な人々がキーボードとブラウザ画面を囲み、アクセシブルな Web を協働して作るイラスト"
            decoding="async"
            fetchpriority="high"
          />
        </picture>
      </div>
    </div>
  </section>

  <section id="services" class="section" aria-labelledby="services-heading">
    <div class="section__head">
      <p class="eyebrow">Services</p>
      <h2 id="services-heading">提供サービス</h2>
      <p class="lead">診断から実装、運用・教育まで、アクセシビリティ対応を一貫して支援します。</p>
    </div>

    <ul class="card-grid">
      {
        services.map((service, index) => (
          <li class="card">
            <span class="card__icon" aria-hidden="true">
              {index === 0 && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" focusable="false">
                  <circle cx="11" cy="11" r="7"></circle>
                  <path d="M16.5 16.5 21 21"></path>
                </svg>
              )}
              {index === 1 && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" focusable="false">
                  <path d="M8 6 3 12l5 6"></path>
                  <path d="M16 6l5 6-5 6"></path>
                </svg>
              )}
              {index === 2 && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" focusable="false">
                  <path d="M4 5h11a2 2 0 0 1 2 2v12H6a2 2 0 0 1-2-2z"></path>
                  <path d="M17 8h3v11H8"></path>
                </svg>
              )}
            </span>
            {/* リンクテキストはサービス名そのもの。「詳しくはこちら」は使わない (2.4.4 / 2.4.6) */}
            <h3>
              <a class="card__title-link" href={`/services/#${service.id}`}>
                {service.title}
              </a>
            </h3>
            <p>{service.summary}</p>
          </li>
        ))
      }
    </ul>

    <p class="services-more">
      <a class="button button--ghost" href="/services/">サービスの詳細を見る</a>
    </p>
  </section>

  <AnnotationCue topicId="home-hero" />
</BaseLayout>

<style>
  .hero {
    position: relative;
    margin-block-start: var(--space-4);
    padding: clamp(var(--space-8), 5vw, var(--space-16)) clamp(var(--space-4), 4vw, var(--space-12));
    background-color: color-mix(in srgb, var(--color-primary) 7%, var(--color-bg));
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .hero__decoration {
    position: absolute;
    inset-block-start: -6rem;
    inset-inline-end: -4rem;
    inline-size: 18rem;
    block-size: 18rem;
    border-radius: 50%;
    background: radial-gradient(
      circle at center,
      color-mix(in srgb, var(--color-primary) 16%, transparent),
      transparent 70%
    );
    pointer-events: none;
  }

  /* 二分割。DOM 順は本文→ビジュアル。
   * デスクトップ既定で横並びとし、狭い幅だけ縦積みにする。
   * （min-width: 48rem だと OS 拡大／ブラウザズームで PC でも縦積みになりやすい） */
  .hero__grid {
    position: relative;
    display: grid;
    gap: var(--space-6) var(--space-8);
    align-items: start;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
  }

  @media (max-width: 40rem) {
    .hero__grid {
      grid-template-columns: 1fr;
    }
  }

  .hero__body {
    min-width: 0;
    max-width: 36rem;
  }

  .hero h1 {
    font-size: var(--text-4xl);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-block-start: var(--space-8);
    max-width: none;
  }

  .hero__visual {
    min-width: 0;
    justify-self: stretch;
    inline-size: 100%;
    max-inline-size: 32rem;
    border-radius: var(--radius-lg);
    background-color: var(--color-surface);
    border: 1px solid var(--color-border-subtle);
    box-shadow: var(--shadow-sm);
    overflow: hidden;
  }

  @media (max-width: 40rem) {
    .hero__visual {
      justify-self: center;
      max-inline-size: min(100%, 28rem);
    }
  }

  .hero__image {
    display: block;
    width: 100%;
    height: auto;
  }

  /* わずかな浮遊。情報伝達ではなく存在感のため。reduced-motion で停止 */
  @media (prefers-reduced-motion: no-preference) {
    .hero__visual {
      animation: hero-float 7s ease-in-out infinite;
    }
  }

  @keyframes hero-float {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-0.4rem);
    }
  }

  .card__title-link {
    color: var(--color-text);
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  .card__title-link:hover {
    color: var(--color-link);
  }

  .services-more {
    margin-block-start: var(--space-8);
  }

  @media (forced-colors: active) {
    .hero__visual {
      border-color: CanvasText;
    }
  }
</style>

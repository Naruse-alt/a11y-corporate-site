{
  "name": "a11y-corporate-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.22.1"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build && node scripts/generate-csp.mjs",
    "preview": "astro preview",
    "preview:cf": "npm run build && wrangler dev",
    "deploy:cf": "npm run build && wrangler deploy",
    "check": "astro check",
    "contrast": "node scripts/contrast.mjs",
    "test:basic-auth": "node scripts/test-basic-auth.mjs",
    "test:csp": "node scripts/generate-csp.mjs --check",
    "test:e2e": "npm run build && playwright test"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans-jp": "^5.3.1",
    "astro": "^7.4.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "typescript": "^5.9.2",
    "wrangler": "^4.131.1"
  }
}
